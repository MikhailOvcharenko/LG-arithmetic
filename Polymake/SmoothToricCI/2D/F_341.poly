# List of 2d irreducible Minkowski summands


use application "polytope";


my $F_0 = new Matrix([[1, 1, 0], [1, 0, 1], [1, 0, 0]]);
my $P_0 = new Polytope(POINTS=>$F_0);
my $W_0 = $P_0->LATTICE_WIDTH;
print("Vertices:\n");
print($F_0);
print("Lattice width: ");
print($W_0);
print("\n");


