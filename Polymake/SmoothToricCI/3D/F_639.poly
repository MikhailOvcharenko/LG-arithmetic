# F_639
# List of 3d irreducible Minkowski summands


use application "polytope";


my $F_0 = new Matrix([[1, 0, 0, 0], [1, 0, 0, 1], [1, 2, 0, 0], [1, 0, 2, 0]]);
my $P_0 = new Polytope(POINTS=>$F_0);
my $LW_0 = $P_0->LATTICE_WIDTH;
my $FW_0 = $P_0->FACET_WIDTHS;
my $FWmin_0 = minimum($FW_0);
my $Facets_0 = $P_0->FACETS;
my $M_0 = $P_0->MINKOWSKI_CONE;
my $R_0 = $M_0->N_RAYS;
print("Vertices:\n");
print($F_0);
print("Lattice width: ");
print($LW_0);
print("\nFacets: \n");
print($Facets_0);
print("Facet widths: ");
print($FW_0);
print("\nFacet width (minimal): ");
print($FWmin_0);
print("\nRays in Minkowski cone: ");
print($R_0);
print("\n");


